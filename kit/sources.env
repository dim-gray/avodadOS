# Where fetch.sh gets everything. Environment variables win over these defaults.
# ReactOS release folder on SourceForge (https://sourceforge.net/projects/reactos/files/ReactOS/)
: "${REACTOS_VERSION:=0.4.15}"

# Apps are pinned to the last versions that target XP-era Windows, because those are
# the ones with a realistic chance of running on ReactOS. Newer builds need APIs
# ReactOS does not have yet.
FIREFOX_URL="https://archive.mozilla.org/pub/firefox/releases/52.9.0esr/win32/en-US/Firefox%20Setup%2052.9.0esr.exe"

VLC_INDEX="https://download.videolan.org/pub/videolan/vlc/2.2.8/win32/"
VLC_REGEX='vlc-2\.2\.8-win32\.exe'

LIBREOFFICE_INDEX="https://downloadarchive.documentfoundation.org/libreoffice/old/5.4.7.2/win/x86/"
LIBREOFFICE_REGEX='LibreOffice_[0-9._]+_Win_x86\.msi'

PYTHON_URL="https://www.python.org/ftp/python/3.4.4/python-3.4.4.msi"
